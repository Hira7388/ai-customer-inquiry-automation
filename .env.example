# Copy this file to .env on the computer running Docker Compose.
# Replace the password with a random URL-safe value before exposing the DB on a LAN.
POSTGRES_PASSWORD=replace_with_random_password
POSTGRES_BIND_IP=127.0.0.1

# Set these as process environment variables on the computer running Python.
# Replace the password and host with the values used by PostgreSQL.
DATABASE_URL=postgresql+psycopg://app:replace_with_random_password@127.0.0.1:5432/inquiries
TEST_DATABASE_URL=postgresql+psycopg://app:replace_with_random_password@127.0.0.1:5432/inquiries_test
